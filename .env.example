# Indian Stock Research Platform - Environment Configuration

# Backend server
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./stocks.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider Configuration
# Option 1: Local Ollama (Qwen 2.5 Coder 7B)
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b
LLM_TEMPERATURE=0.2

# Option 2: OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.2

# Option 3: Google Gemini (via OpenAI compatibility)
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSy...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-flash
# LLM_TEMPERATURE=0.2
